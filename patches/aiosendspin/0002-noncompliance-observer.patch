+    def _observe_noncompliance(
+        self, connection: int | None, client_id: str | None, reason: str
+    ) -> None:
+        """Hand one flagged spec violation to the non-compliance observer, if there is one."""
+        observer = self._noncompliance_observer
+        if observer is None:
+            return
+        try:
