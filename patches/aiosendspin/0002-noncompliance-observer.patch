index 0000000..b8c4f49
--- /dev/null
+++ b/tests/integration/test_noncompliance_observer.py
@@ -0,0 +1,169 @@
+"""End-to-end tests for the server's non-compliance observer."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+
+import pytest
+from aiohttp import ClientSession, WSMsgType, web
+from aiohttp.test_utils import TestServer
+
+from aiosendspin.models.types import Roles
+from aiosendspin.noise.keys import Identity
+from aiosendspin.noise.trust_store import InMemoryClientPairingStore, InMemoryServerPairingStore
+from aiosendspin.server import ObservedFrame, ObservedNoncompliance, SendspinServer
+from aiosendspin.server.compliance import ClientComplianceError
+from tests.conftest import make_sdk_client
+from tests.noise.conftest import non_canonical_peer_id
+
+
+def _make_server(
+    observed: list[ObservedNoncompliance],
+    *,
+    allow_noncompliant_clients: bool = False,
+    frames: list[ObservedFrame] | None = None,
+) -> SendspinServer:
+    return SendspinServer(
+        loop=asyncio.get_running_loop(),
+        identity=Identity.generate(),
+        server_name="test-server",
+        pairing_store=InMemoryServerPairingStore(),
+        allow_noncompliant_clients=allow_noncompliant_clients,
+        frame_observer=frames.append if frames is not None else None,
+        noncompliance_observer=observed.append,
+    )
+
+
+@asynccontextmanager
+async def _serve(server: SendspinServer) -> AsyncIterator[str]:
+    app = web.Application()
+    app.router.add_get(SendspinServer.API_PATH, server.on_client_connect)
+    test_server = TestServer(app)
+    await test_server.start_server()
+    try:
+        yield f"ws://127.0.0.1:{test_server.port}{SendspinServer.API_PATH}"
+    finally:
+        await test_server.close()
+        await server.close()
+
+
+async def test_observer_sees_a_violation_before_the_handshake_names_the_client() -> None:
+    """A client/init violation is reported with its connection and no client id."""
+    observed: list[ObservedNoncompliance] = []
+    frames: list[ObservedFrame] = []
+    server = _make_server(observed, frames=frames)
+    client_init = {
+        "type": "client/init",
+        "payload": {
+            "client_id": non_canonical_peer_id(Identity.generate().peer_id),
+            "version": 1,
+            "suite": "25519_ChaChaPoly_SHA256",
+        },
+    }
+    async with (
+        _serve(server) as url,
+        ClientSession() as session,
+        session.ws_connect(url) as ws,
+    ):
+        await ws.send_str(json.dumps(client_init))
+        while (await asyncio.wait_for(ws.receive(), timeout=5)).type is WSMsgType.TEXT:
+            pass
+
+    assert [(o.connection, o.client_id, o.reason) for o in observed] == [
+        (frames[0].connection, None, "client/init client_id is not canonical base64url")
+    ]
+
+
+async def test_observer_sees_a_violation_by_an_attached_client() -> None:
+    """A violation after the handshake carries the client id and its connection number."""
+    observed: list[ObservedNoncompliance] = []
+    frames: list[ObservedFrame] = []
+    flagged = asyncio.Event()
+
+    def observe(observation: ObservedNoncompliance) -> None:
+        observed.append(observation)
+        flagged.set()
+
+    server = SendspinServer(
+        loop=asyncio.get_running_loop(),
+        identity=Identity.generate(),
+        server_name="test-server",
+        pairing_store=InMemoryServerPairingStore(),
+        allow_noncompliant_clients=False,
+        frame_observer=frames.append,
+        noncompliance_observer=observe,
+    )
+    client_identity = Identity.generate()
+
+    async with _serve(server) as url:
+        client = make_sdk_client(
+            identity=client_identity,
+            pairing_store=InMemoryClientPairingStore(),
+            client_name="c",
+            roles=[Roles.CONTROLLER],
+        )
+        try:
+            await client.connect(url)
+            connection = client._admitted_connection  # noqa: SLF001
+            assert connection is not None
+            assert connection._ws is not None  # noqa: SLF001
+            await connection._ws.send_str(  # noqa: SLF001
+                json.dumps({"type": "client/state", "payload": {}})
+            )
+            async with asyncio.timeout(5):
+                await flagged.wait()
+        finally:
+            await client.disconnect()
+
+    assert [(o.connection, o.client_id, o.reason) for o in observed] == [
+        (
+            frames[0].connection,
+            client_identity.peer_id,
+            "client/state omitted the required 'available' field",
+        )
+    ]
+    assert observed[0].monotonic_us >= frames[0].monotonic_us
+
+
+async def test_lenient_server_reports_every_occurrence() -> None:
+    """A tolerated violation reaches the observer each time, though it is logged once."""
+    observed: list[ObservedNoncompliance] = []
+    server = _make_server(observed, allow_noncompliant_clients=True)
+    client = server.get_or_create_client("dev")
+
+    client.flag_noncompliance("legacy thing")
+    client.flag_noncompliance("legacy thing")
+
+    assert [(o.connection, o.client_id, o.reason) for o in observed] == [
+        (None, "dev", "legacy thing"),
+        (None, "dev", "legacy thing"),
+    ]
+    await server.close()
+
+
+async def test_observer_that_raises_does_not_change_the_verdict(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """An observer's exception is logged, and a strict server still rejects the client."""
+
+    def fail(_: ObservedNoncompliance) -> None:
+        raise ValueError("observer broke")
+
+    server = SendspinServer(
+        loop=asyncio.get_running_loop(),
+        identity=Identity.generate(),
+        server_name="test-server",
+        pairing_store=InMemoryServerPairingStore(),
+        allow_noncompliant_clients=False,
+        noncompliance_observer=fail,
+    )
+    client = server.get_or_create_client("dev")
+
+    with pytest.raises(ClientComplianceError):
+        client.flag_noncompliance("legacy thing")
+
+    assert "Error in non-compliance observer" in caplog.messages
+    await server.close()
