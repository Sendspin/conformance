+async def test_server_frame_tap_sees_cleartext_handshake_then_transport() -> None:
+    """The tap sees each handshake frame as cleartext, then rides the encrypted socket."""
+    server_id, client_id = Identity.generate(), Identity.generate()
+    psk = generate_psk()
+    server_psk = ResolvedPsk(psk_id_for(psk), psk, PskCategory.LONG_TERM, client_id.peer_id)
+    client_psk = replace(server_psk, counterparty_id=server_id.peer_id)
+    server_ws, client_ws = make_ws_pair()
+    tap = _RecordingTap()
+
+    server_result, _ = await asyncio.gather(
+        run_handshake_server(
+            server_ws,
+            local_identity=server_id,
+            psk_provider=_provider(server_psk),
+            frame_tap=tap,
+        ),
+        run_handshake_client(
+            client_ws,
+            local_identity=client_id,
+            suite=NoiseCipherSuite.CHACHAPOLY,
+            psk_resolver=_resolver({client_psk.psk_id: client_psk}),
+        ),
+    )
+    await server_result.encrypted_ws.send_str("{}")
+
+    cleartext = [frame for frame in tap.frames if frame[1] is FramePhase.CLEARTEXT]
+    assert [(direction, orjson.loads(data)["type"]) for direction, _, data in cleartext] == [
+        (FrameDirection.IN, "client/init"),
+        (FrameDirection.OUT, "server/init"),
+        (FrameDirection.OUT, "noise/handshake"),
+        (FrameDirection.IN, "noise/handshake"),
+    ]
+    assert [data.decode("utf-8") for _, _, data in cleartext] == [
+        client_ws.sent[0],
+        server_ws.sent[0],
+        server_ws.sent[1],
+        client_ws.sent[1],
+    ]
+    assert tap.frames[len(cleartext) :] == [(FrameDirection.OUT, FramePhase.TRANSPORT, b"\x00{}")]
