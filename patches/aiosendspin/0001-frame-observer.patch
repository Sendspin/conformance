@@ -0,0 +1,133 @@
+"""End-to-end tests for the server's frame observer."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from typing import TYPE_CHECKING
+
+import orjson
+from aiohttp import ClientSession, WSMsgType, web
+from aiohttp.test_utils import TestServer
+
+from aiosendspin.models.core import ClientHelloMessage, ClientHelloPayload
+from aiosendspin.models.types import Roles
+from aiosendspin.noise.keys import Identity
+from aiosendspin.noise.trust_store import InMemoryServerPairingStore
+from aiosendspin.server import (
+    FrameDirection,
+    FrameObserver,
+    FramePhase,
+    ObservedFrame,
+    SendspinServer,
+)
+from tests.conftest import make_sdk_client
+
+if TYPE_CHECKING:
+    import pytest
+
+
+@asynccontextmanager
+async def _serve(
+    frame_observer: FrameObserver, *, allow_unencrypted: bool = False
+) -> AsyncIterator[tuple[SendspinServer, str]]:
+    server = SendspinServer(
+        loop=asyncio.get_running_loop(),
+        identity=Identity.generate(),
+        server_name="test-server",
+        pairing_store=InMemoryServerPairingStore(),
+        allow_unencrypted=allow_unencrypted,
+        frame_observer=frame_observer,
+    )
+    app = web.Application()
+    app.router.add_get(SendspinServer.API_PATH, server.on_client_connect)
+    test_server = TestServer(app)
+    await test_server.start_server()
+    try:
+        yield server, f"ws://127.0.0.1:{test_server.port}{SendspinServer.API_PATH}"
+    finally:
+        await test_server.close()
+        await server.close()
+
+
+def _message_type(frame: ObservedFrame) -> str:
+    text = frame.data if frame.phase is FramePhase.CLEARTEXT else frame.data[1:]
+    return str(orjson.loads(text)["type"])
+
+
+async def test_observer_sees_handshake_and_hellos_in_order() -> None:
+    """Every frame of a connection reaches the observer, tagged with its connection."""
+    frames: list[ObservedFrame] = []
+    identity = Identity.generate()
+    async with _serve(frames.append) as (_, url):
+        client = make_sdk_client(identity=identity, client_name="c", roles=[Roles.CONTROLLER])
+        try:
+            await client.connect(url)
+        finally:
+            await client.disconnect()
+
+    json_frames = [f for f in frames if f.phase is FramePhase.CLEARTEXT or f.data[0] == 0]
+    assert [(f.direction, f.phase, _message_type(f)) for f in json_frames[:7]] == [
+        (FrameDirection.IN, FramePhase.CLEARTEXT, "client/init"),
+        (FrameDirection.OUT, FramePhase.CLEARTEXT, "server/init"),
+        (FrameDirection.OUT, FramePhase.CLEARTEXT, "noise/handshake"),
+        (FrameDirection.IN, FramePhase.CLEARTEXT, "noise/handshake"),
+        (FrameDirection.OUT, FramePhase.TRANSPORT, "server/hello"),
+        (FrameDirection.IN, FramePhase.TRANSPORT, "client/hello"),
+        (FrameDirection.OUT, FramePhase.TRANSPORT, "server/activate"),
+    ]
+    assert {f.connection for f in frames} == {1}
+    assert {f.client_id for f in frames[4:]} == {identity.peer_id}
+    assert all(f.error is None for f in frames)
+    times = [f.monotonic_us for f in frames]
+    assert times == sorted(times)
+
+
+async def test_failing_observer_is_logged_once_and_does_not_break_the_connection(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """An observer that raises on every frame leaves the session working."""
+
+    def observe(_frame: ObservedFrame) -> None:
+        raise RuntimeError("observer failed")
+
+    async with _serve(observe) as (server, url):
+        identity = Identity.generate()
+        client = make_sdk_client(identity=identity, client_name="c", roles=[Roles.CONTROLLER])
